<column padding="20" gap="16">
  <text size="xxl" weight="bold">KTML 测试</text>
  <text size="sm" color="muted">模板 + 脚本分离</text>

  <card padding="16" radius="lg">
    <column gap="8">
      <text size="lg" weight="semibold">水果列表</text>
      <for each="item in items" key="id">
        <row justify="space-between">
          <text size="md">{{ item.name }}</text>
          <text size="sm" color="muted">¥{{ item.price }}</text>
        </row>
      </for>
    </column>
  </card>

  <card padding="16" radius="lg">
    <column gap="8">
      <text size="lg" weight="semibold">条件渲染</text>
      <if test="showTip">
        <text size="sm" color="primary">✓ 条件已显示</text>
      </if>
      <if test="!showTip">
        <text size="sm" color="muted">条件未显示</text>
      </if>
    </column>
  </card>
</column>

<script>
var items = [
  { id: 1, name: '苹果', price: '8.5' },
  { id: 2, name: '香蕉', price: '3.2' },
  { id: 3, name: '橙子', price: '5.0' }
];
var showTip = true;
</script>
